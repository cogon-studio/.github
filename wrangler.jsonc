{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cogon-studio",
	"compatibility_date": "2026-09-19",
	"assets": {
		"directory": "./build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{ "pattern": "cogon.studio", "custom_domain": true },
		{ "pattern": "www.cogon.studio", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
